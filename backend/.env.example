# === DATABASE ===
DATABASE_URL=postgresql://user:pass@host:5432/sage_db

# === BRAND (Sage IT Co) ===
BRAND_NAME=Sage IT Co
BRAND_SHORT_NAME=Sage
BRAND_LEGAL_NAME=Sage IT Co
BRAND_TAGLINE=IT Consulting and Career Development
BRAND_CONTACT_EMAIL=info@sageitco.com
BRAND_SUPPORT_EMAIL=support@sageitco.com
BRAND_NOREPLY_EMAIL=noreply@sageitco.com
BRAND_WEBSITE=https://sageitco.com
BRAND_ID_PREFIX=SAGE
BRAND_PRIMARY_COLOR=#1B2A5C
BRAND_LETTERHEAD_PATH=sage_letterhead.pdf
BRAND_LOGO_URL=https://sageitco.com/sage_logo.png

# === JWT ===
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# === CLOUDINARY (new Sage account) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === AWS S3 (Phase 1 document storage) ===
# Private bucket, Block Public Access ON, versioning + SSE-S3 enabled.
# Credentials are read by the AWS SDK DefaultCredentialsProvider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=sageit-erm-documents

# === EMAIL (Gmail SMTP, direct) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=noreply@sageitco.com
SMTP_PASSWORD=

# === CRON ===
CRON_SECRET=

# === FRONTEND ===
FRONTEND_URL=https://sageitco.com

# === ADMIN SEED ===
SEED_ADMIN_EMAIL=admin@sageitco.com
SEED_ADMIN_PASSWORD=
